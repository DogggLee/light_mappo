   "source": [
    "import numpy as np\n",
    "import math\n",
    "\n",
    "a = np.array([0., 1.])\n",
    "b = np.array([1., 0.])\n",
    "\n",
    "cross = a[0] * b[1] - b[0]*a[1]\n",
    "dot = np.dot(a, b)   \n",
    "\n",
    "rel = np.arctan2(cross, dot)\n",
    "\n",
    "print(rel, np.degrees(rel))"
   ]
